# pacod-kb settings. `make setup` copies this file to .env and generates every blank secret the
# configured services need (never printed); docker-compose.yml passes each service only its own.
# Comments go on their own line above a blank value: Compose reads `KEY=   # text` as the value.

# ---- services (docker compose profiles) -----------------------------------------------------------
# pipeline, ui: kb itself · server: bundled Qdrant · db: bundled PostgreSQL
# id: bundled pacod-id (sign-in) · mailpit: catches its mails · dev-gateway: gw-lite + mock providers
COMPOSE_PROFILES=pipeline,server,db,ui,id,mailpit,dev-gateway

# ---- knowledge base -------------------------------------------------------------------------------
KB_ROOT=/data/kb                 # external knowledge-base root (mounted volume)
KB_DROPZONE=/data/kb/dropzone    # dropzone directory
KB_DONE=/data/kb/done            # processed dropzone files
KB_FAILED=/data/kb/failed        # failed dropzone files
DROPZONE_INTERVAL_SECS=60        # refresh interval for the dropzone (0 = off)
GIT_AUTOCOMMIT=true              # auto-commit canonical archive on ingest
LOG_LEVEL=INFO

QDRANT_MODE=server               # embedded | server
QDRANT_URL=http://kb-qdrant:6333 # used only when QDRANT_MODE=server
# optional, server mode
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks
QDRANT_IMAGE_TAG=latest          # pin to the Qdrant version you run (storage is not downgradable)
EMBEDDING_MODEL=BAAI/bge-m3
# Inference on CPU. Threads 0 = derived from the container's CPU quota (torch and docling share it).
# Ingest embeds micro-batches of at most EMBED_BATCH_TOKENS padded tokens; a query waits for one.
TORCH_NUM_THREADS=0
EMBED_BATCH_TOKENS=1024
QUERY_EMBED_CACHE_SIZE=256       # recent query embeddings kept in memory; 0 disables
# Keyword half of hybrid search: legacy (every word must match) | or | and_or (analysed terms:
# stopwords dropped, inflections as prefixes). See docs/retrieval-eval.md before changing.
KEYWORD_QUERY_MODE=legacy
RRF_KEYWORD_WEIGHT=1.0
KEYWORD_PG_TIMEOUT_MS=1500
# Second-stage reranker (cross-encoder on CPU). Off until measured on this machine:
# make eval-docker / make rerank-probe (docs/retrieval-eval.md). Also switchable at runtime.
RERANKER_ENABLED=false
# Blank = BAAI/bge-reranker-v2-m3. RERANKER_REVISION pins the model revision (a commit hash).
RERANKER_MODEL=
RERANKER_REVISION=
RERANKER_TRUST_REMOTE_CODE=false # true only for models that need it (e.g. gte); pin the code too
RERANKER_CODE_REVISION=
RERANK_TOP_N=10                  # fused candidates the reranker scores (latency grows with it)
RERANK_MAX_LENGTH=384
RERANK_BATCH_SIZE=16
RERANK_GATE_TIMEOUT_MS=1000      # past it (ingest busy) the query keeps the fused order
RETRIEVAL_CANDIDATE_K=50         # per-leg candidates when reranking
INFERENCE_DEVICE=auto            # auto | cpu | cuda | mps
# 1 = never download models at runtime (the model cache must already hold them)
HF_HUB_OFFLINE=
# A job submitted while another runs waits its turn (up to this long for a dropzone scan).
JOB_LOCK_TIMEOUT_SECS=3600
# Unchanged chunks keep their vectors when a document is superseded or the index rebuilt.
# Vectors stored before this release carry no model tag: set EMBED_REUSE_UNTAGGED=true only if
# EMBEDDING_MODEL never changed. REBUILD_REUSE_MAX_POINTS caps the rebuild's snapshot
# (4 KB of RAM per vector).
EMBED_REUSE=true
EMBED_REUSE_UNTAGGED=false
REBUILD_REUSE_MAX_POINTS=100000

# Storage backend (filesystem | database). Bundled PostgreSQL (profile db): keep the defaults;
# an external one: set every KB_DATABASE_* value. Switching does not migrate documents.
KB_STORAGE_BACKEND=database
KB_DATABASE_HOST=postgres
KB_DATABASE_PORT=5432
KB_DATABASE_NAME=kb
KB_DATABASE_USER=kb
KB_DATABASE_PASSWORD=

# Ingest checks
CONTENT_SECURITY_ENABLED=true      # prompt-injection / spam scan of ingested documents
CONTENT_NOISE_FILTER_ENABLED=true  # strip page numbers, running headers, boilerplate phrases
# PDF tables: accurate (default) or fast. With OCR_ENABLED=true, a page read by a single OCR
# engine (no tesseract CLI installed) gets OCR_SINGLE_ENGINE_CONFIDENCE, compared with
# OCR_CONFIDENCE_THRESHOLD (0.95): below it the document goes to review.
DOCLING_TABLE_MODE=accurate
OCR_SINGLE_ENGINE_CONFIDENCE=0.8

# ---- AI: the gateway (pacod-gw) -------------------------------------------------------------------
# Every LLM call goes through pacod-gw: it holds the provider keys, routes, fails over and prices
# each call. Blank URL or key = AI off (documents keep their deterministic parse).
# Development: profile dev-gateway, PACOD_GW_URL=http://gw:8080, the key generated by make setup.
# Production: a real gateway (pacod-gw, or pacod-gw/deploy/lite with real PGW_PROVIDER_*_KEY).
PACOD_GW_URL=http://gw:8080         # no /v1
# this installation's gateway key, pgw_kb_...
PACOD_GW_API_KEY=
# Model names are the gateway's: provider/model, or a pool @name.
# The development gateway's mock echoes the prompt, so conversion is off here; turn it on with a
# real gateway.
LLM_CONVERTER_ENABLED=false
LLM_CONVERTER_MODEL=anthropic/claude-opus-5-5
LLM_CONVERTER_MAX_TOKENS=64000      # output cap (the converter streams)
# blank = the model's own sampling
LLM_CONVERTER_TEMPERATURE=
CONTENT_SECURITY_LLM_ENABLED=false  # an LLM second opinion on non-blocking scan verdicts
CONTENT_SECURITY_LLM_MODEL=anthropic/claude-haiku-4-5

# ---- web UI ---------------------------------------------------------------------------------------
UI_PORT=8080                     # host port for kb-ui
UI_BIND=127.0.0.1                # host address it is published on (0.0.0.0 for a LAN install)
UI_FORWARDED_ALLOW_IPS=127.0.0.1 # proxies whose X-Forwarded-* the UI believes
PIPELINE_API_URL=http://kb-pipeline:8000
# shared secret for X-API-Key (UI -> pipeline); required
PIPELINE_API_SECRET=
# signs browser session cookies
UI_SESSION_SECRET=
UI_SESSION_HTTPS_ONLY=false      # true when serving the UI over HTTPS
UI_DB_PATH=/data/kb-ui/users.db  # the UI's SQLite file: server-side sessions (volume kb_ui_data)
UI_SESSION_MAX_AGE_SECS=43200       # a UI session lasts at most this long (and ends with pacod-id's)

# ---- sign-in: pacod-id (profile id) -----------------------------------------------------------------
# The issuer is the address browsers use for pacod-id's sign-in pages; KB_UI_ORIGIN the UI's.
# Development: both on this machine. Production: https addresses behind a proxy.
KB_ID_ISSUER=http://127.0.0.1:18070
KB_ID_PORT=18070
KB_UI_ORIGIN=http://localhost:8080
ID_ADMIN_EMAIL=admin@pacod-kb.test  # the first account: identity admin and kb admin
# its first password (12+ characters); change it after signing in
ID_ADMIN_PASSWORD=
# pacod-id's own secrets (generated; back them up -- PID_KEK seals what pacod-id stores)
PID_PG_SUPERUSER_PASSWORD=
PID_DB_PASSWORD=
PID_KEK=
PID_TOKEN_PEPPER=
# the UI's client secret (pacod-kb-ui)
KB_ID_UI_SECRET=
# the UI's service client secret (pacod-kb-service)
KB_ID_SERVICE_SECRET=
# Another pacod-id instead of the bundled one: drop the id profile, set KB_ID_ISSUER to its
# public address and PACOD_ID_INTERNAL_URL to where the UI reaches its internal listener.
PACOD_ID_INTERNAL_URL=
# Mail: blank host = mailpit (profile mailpit, http://127.0.0.1:18025). Production names a relay.
PID_SMTP_HOST=
PID_SMTP_PORT=
PID_SMTP_TLS=
PID_SMTP_USERNAME=
PID_SMTP_PASSWORD=
ID_MAIL_FROM=
# the proxy in front of pacod-id, in production
PID_TRUSTED_PROXIES=
KB_MAILPIT_PORT=18025

# ---- fetch hardening and limits ---------------------------------------------------------------------
WEB_FETCH_ALLOW_PRIVATE=true     # false = refuse hosts resolving to private/loopback/link-local IPs (SSRF guard; recommended in production)
ALLOW_INSECURE_TLS=true          # retry without certificate verification on TLS errors (logged)
WEB_FETCH_MAX_BYTES=52428800     # max response size per fetch (50 MB)
UPLOAD_MAX_BYTES=209715200       # max upload size for /ingest/file (200 MB)
PDF_MAX_PAGES=2000
PDF_MAX_BYTES=209715200
