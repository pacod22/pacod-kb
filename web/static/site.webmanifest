{
  "name": "pacod-kb",
  "short_name": "pacod-kb",
  "description": "pacod-kb, the knowledge base: ingest, search and versioned documents",
  "start_url": "/kb",
  "scope": "/kb",
  "display": "standalone",
  "background_color": "#fbfbf8",
  "theme_color": "#0e6e57",
  "icons": [
    {
      "src": "/kb/static/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/kb/static/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/kb/static/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/kb/static/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/kb/static/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
