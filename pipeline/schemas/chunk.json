{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chunk",
  "type": "object",
  "required": [
    "chunk_id",
    "source_id",
    "heading_path",
    "heading_level",
    "parent_id",
    "sequence",
    "byte_start",
    "byte_end",
    "text",
    "raw_text",
    "chunk_type",
    "content_hash",
    "valid_until",
    "extraction_method",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "heading_path": {
      "type": "array",
      "items": {"type": "string"}
    },
    "heading_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "parent_id": {
      "type": ["string", "null"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "byte_start": {
      "type": "integer",
      "minimum": 0
    },
    "byte_end": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "raw_text": {
      "type": "string"
    },
    "chunk_type": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "valid_until": {
      "type": ["string", "null"]
    },
    "extraction_method": {
      "type": "string",
      "enum": ["deterministic", "ocr", "vlm"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
