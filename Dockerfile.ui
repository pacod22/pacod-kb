# syntax=docker/dockerfile:1
# ── build: resolve the UI dependency group from uv.lock (no docling/torch) ──
FROM python:3.13-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app

COPY pyproject.toml uv.lock ./
# pacod-id's Python package, vendored (scripts/vendor-pacod-id.sh; [tool.uv.sources]).
COPY vendor/wheels/ vendor/wheels/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --only-group ui --no-install-project

# ── runtime ──
FROM python:3.13-slim

RUN useradd --create-home --uid 10001 app
WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY web/ web/
# Readable by the app user (uid 10001) whatever modes the build context had.
RUN chmod -R a+rX /app/web
COPY docker/ui/entrypoint.py /usr/local/bin/kb-ui-entrypoint
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8080
# /kb/healthz answers 200 whether or not pacod-id is reachable (/kb/login redirects to it).
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/kb/healthz', timeout=4)" || exit 1

ENTRYPOINT ["kb-ui-entrypoint"]
# One worker: sessions' refresh locks, the pacod-id feed follower and the catalogue push live
# in the process. Behind a proxy, FORWARDED_ALLOW_IPS (compose: UI_FORWARDED_ALLOW_IPS) names it.
CMD ["uvicorn", "web.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--proxy-headers"]
